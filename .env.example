# Polymarket CLOB credentials
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
POLY_FUNDER=
POLY_PK=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading parameters
BANKROLL_BALANCE=100
KELLY_FRACTION=0.15
KELLY_MIN_BET=1.50
KELLY_MAX_BET=3.50
MIN_WIN_PROB=0.75
MIN_EDGE_THRESHOLD=0.05
ENTRY_MIN=0.15
ENTRY_MAX=0.68
MIN_DISTANCE_PCT=0.0008
WARMUP_SEC=45

# Trading hours (Lima timezone)
SKIP_NIGHT_HOURS=true
NIGHT_START_HOUR=22
NIGHT_END_HOUR=14

# Tor proxy
USE_TOR=true

# Arbitrage (disabled)
ARB_ENABLED=false

# ── Jun 12 2026 audit: entry discipline + empirical calibration + sizing ──
# Empirical probability shrink: cal = anchor(|dist|) + alpha*(prob-0.50).
# Fitted on graded outcomes (n=214 Apr-Jun; raw probs ~22pp overconfident).
EMP_SHRINK_ON=on
EMP_SHRINK_ALPHA=0.30
EMP_SHRINK_D1=0.0010
EMP_SHRINK_D2=0.0015
EMP_SHRINK_WR1=0.52
EMP_SHRINK_WR2=0.60
EMP_SHRINK_WR3=0.68
EMP_SHRINK_LO=0.35
EMP_SHRINK_HI=0.82
# Confidence thresholds in the shrunk-prob space
CONF_HIGH_PROB=0.62
CONF_HIGH_EDGE=0.08
# MEDIUM-confidence trades won 39.4% (n=33) vs HIGH 58.8% — de-size, not block
CONF_MULT_MEDIUM=0.6
# Entry discipline: 60-69c bucket lost -$46 at 52.5% WR (n=59, 30d)
ENTRY_MAX_DOWN=0.66
MIN_WIN_PROB=0.55
EXPENSIVE_DOWN_MAX_ASK=0.58
EXPENSIVE_DOWN_BOOK_AGREE_MAX=0.66
EXPENSIVE_DOWN_BOOK_AGREE_DIST=0.0015
# Distance-tier sizing (sweet 0.10-0.25% won 64-75%; <0.10% won 44%)
SIZE_SH_SWEET=9
SIZE_SH_OK=5
SIZE_SH_TAIL=3
SIZE_SWEET_LO=0.0010
SIZE_SWEET_HI=0.0025
SIZE_OK_LO=0.0008
SIZE_OK_HI=0.0030
# Session multipliers re-derived from rolling 30d EV (PM was -$50 at 1.4x)
SIZE_MULT_MIDDAY=1.10
SIZE_MULT_AFTERNOON=1.00

# ── Jun 12 2026 PM audit: chop repricing, net stop, correlated-fill de-size ──
# In CHOPPY regime, lower the EMP-shrink anchor per dist tier (mid-distance
# leads mean-revert in chop: CHOPPY 0.10-0.15% won 40% n=10 vs TRENDING 77.8% n=9)
EMP_CHOP_DELTA1=0.0
EMP_CHOP_DELTA2=0.06
EMP_CHOP_DELTA3=0.0
# Daily stop on net drawdown (losses - wins); "gross" restores old behavior
DAILY_STOP_MODE=net
# De-size any 2nd same-direction fill in the same window (1.0 disables)
CORR_SECOND_MULT=0.5
